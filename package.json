{
  "name": "opencmdb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise hardware asset discovery & CMDB (baremetal, hypervisors, VMs, storage, network)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init-db": "node src/db/migrate.js",
    "docs": "node docs/generate.mjs",
    "test": "for t in recon redfish ssh vcenter platform; do node test/$t.test.mjs || exit 1; done"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "net-snmp": "^3.20.0",
    "p-limit": "^6.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "docx": "^9.7.1"
  }
}
